# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# Architecture:
#   PRIMARY BACKEND = the real backend (API, auth, database, WebSocket)
#   FALLBACK SERVER = frontend/server (localhost:3001) — only when primary is down
#   MOCK DATA = client-side mock data — used when BOTH servers are unavailable
#
# Request flow:
#   1. Try PRIMARY BACKEND (VITE_API_URL)
#   2. If unavailable → try FALLBACK SERVER (VITE_FALLBACK_API_URL)
#   3. If both unavailable → use MOCK DATA (automatic, no config needed)
#
# Vercel deployment: set these in Vercel Dashboard → Settings → Environment Variables.

# =============================================================================
# PRIMARY BACKEND (Real backend — source of truth)
# =============================================================================
# The REAL backend URL. All API and WebSocket requests go here first.
# If unreachable, the frontend falls back to the fallback server, then mock data.
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ LOCAL DEV:                                                     │
# │   Option A — Use Vite proxy (recommended):                     │
# │     Leave VITE_API_URL UNSET.                                  │
# │     apiFetch uses relative /api paths → Vite proxy →           │
# │     forwards to localhost:3001 (fallback server).               │
# │     Start the fallback server: npm run dev:server              │
# │                                                                │
# │   Option B — Real backend on a different port:                  │
# │     VITE_API_URL=http://localhost:4000/api                     │
# │     VITE_WS_URL=ws://localhost:4000                            │
# │     (The fallback server on 3001 is still available)           │
# │                                                                │
# │ PRODUCTION (Vercel) — Real backend deployed:                   │
# │     VITE_API_URL=https://YOUR-REAL-BACKEND-DOMAIN/api          │
# │     VITE_WS_URL=wss://YOUR-REAL-BACKEND-DOMAIN                │
# │     VITE_USE_MOCK_AUTH=false                                   │
# │                                                                │
# │ PRODUCTION (Vercel) — No backend yet (demo mode):              │
# │     Leave VITE_API_URL empty/unset                             │
# │     Leave VITE_WS_URL empty/unset                              │
# │     The app automatically falls back to client-side mock data  │
# │     for both API and auth. Works as a full demo without any    │
# │     backend server.                                            │
# └─────────────────────────────────────────────────────────────────┘
#
# Leave UNSET for local dev with Vite proxy (Option A above).
VITE_API_URL=

# Leave UNSET for local dev (defaults to ws://localhost:3001).
VITE_WS_URL=

# =============================================================================
# FALLBACK SERVER (frontend/server — localhost:3001)
# =============================================================================
# This is the local fallback server in the server/ directory.
# Only used when the primary backend is unreachable.
# You generally don't need to change these.
VITE_FALLBACK_API_URL=http://localhost:3001/api
VITE_FALLBACK_WS_URL=ws://localhost:3001

# =============================================================================
# MOCK MODES
# =============================================================================
# Set to true to bypass the real backend entirely and use demo/mock auth.
# Useful for:
#   - Local dev without any backend running
#   - Vercel demo deployment without a backend
#   - CI/CD testing
#
# When servers are unavailable, the app automatically falls back to mock data
# for API requests and mock auth for login. These flags force that mode upfront.
VITE_USE_MOCK_AUTH=false

# Set to true to always use mock delivery data regardless of backend status.
# Useful for demos or when the backend doesn't support certain endpoints.
VITE_USE_MOCK_DATA=false
