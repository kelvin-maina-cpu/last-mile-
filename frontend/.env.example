# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and adjust values for your environment.

# API base URL (include /api suffix)
# Development: Vite proxy handles /api → localhost:3001, so relative path works
# Production: Set to your deployed backend URL, e.g. https://api.yourdomain.com/api
VITE_API_URL=http://localhost:3001/api

# WebSocket URL
# Development: backend WS runs on same port as API
# Production: Set to your deployed backend WS URL, e.g. wss://api.yourdomain.com
VITE_WS_URL=ws://localhost:3001

# Mock authentication mode
# Set to true to bypass the real backend entirely and use demo/mock auth.
# Useful for demos, CI, or when the backend is not deployed.
# When false (default), the app tries the real backend first and
# automatically falls back to mock auth only if the backend is unreachable.
VITE_USE_MOCK_AUTH=false

# Mock delivery data (legacy rider demo flag)
# Set to true to always use mock delivery data regardless of backend status.
# When false, mock delivery data is only used as a fallback when the backend
# is unreachable in development mode.
VITE_USE_MOCK_DATA=false
