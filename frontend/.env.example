# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# Vercel deployment: set these in Vercel Dashboard → Settings → Environment Variables.
# If VITE_API_URL is NOT set and the app is deployed (not localhost),
# mock mode activates automatically.

# API base URL (include /api suffix)
# Development: leave as-is (Vite proxy handles /api → localhost:3001)
# Production with backend: set to your backend URL, e.g. https://api.yourdomain.com/api
# Production without backend: leave unset — mock mode auto-activates
VITE_API_URL=http://localhost:3001/api

# WebSocket URL
# Development: leave as-is
# Production with backend: set to your backend WS URL, e.g. wss://api.yourdomain.com
VITE_WS_URL=ws://localhost:3001

# Mock authentication mode
# Set to true to bypass the real backend entirely and use demo/mock auth.
# Useful for demos, CI, or when the backend is not deployed.
# When false (default), the app tries the real backend first and
# automatically falls back to mock auth only if the backend is unreachable.
# NOTE: If VITE_API_URL is not set and the app is deployed on a real domain,
# mock mode activates automatically — you do NOT need to set this.
VITE_USE_MOCK_AUTH=false

# Mock delivery data (legacy rider demo flag)
# Set to true to always use mock delivery data regardless of backend status.
# When false, mock delivery data is only used as a fallback when the backend
# is unreachable in development mode.
VITE_USE_MOCK_DATA=false
