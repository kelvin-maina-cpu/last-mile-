VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001

# TEMPORARY (Mary, Rider frontend dev/demo only):
# Set to true to always use mock delivery data instead of the real
# backend, so the Rider UI can be tested before Kelvin's API is up.
# In dev builds (npm run dev), mock data also kicks in automatically
# if the backend is completely unreachable, even when this is false.
# Leave false/unset once the backend is available; remove entirely
# once mockDeliveries.js is deleted.
VITE_USE_MOCK_DATA=false
