# =============================================================================
# REFLEX FALLBACK SERVER — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.
#
# The fallback server runs on port 3001 and provides:
#   - Auth (email/password + Google OAuth)
#   - In-memory demo data (users, deliveries, ratings)
#   - WebSocket for real-time rider updates
#   - Chatbot API
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# REQUIRED — JWT secret for signing auth tokens.
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Frontend URLs for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173
VERCEL_URL=https://last-mile-m4nv.vercel.app

# Additional CORS origins (comma-separated, optional)
CORS_ORIGINS=

# Google OAuth (leave placeholder values for demo/mock mode)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Logging (optional)
LOG_LEVEL=
