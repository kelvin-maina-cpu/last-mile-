# =============================================================================
# BACKEND (Express) ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# The backend must be deployed separately (e.g. Render, Railway, Fly.io).
# Vercel only hosts the frontend — it cannot run an Express server.

# Server port (default: 3001)
PORT=3001

# Frontend URL for CORS and OAuth redirects
# Development:  http://localhost:5173
# Production:   https://your-frontend-domain.vercel.app
FRONTEND_URL=http://localhost:5173

# Additional CORS origins (comma-separated, optional)
# Useful when you have multiple frontend deployments
# Example: https://staging.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=

# Google OAuth (for "Continue with Google" feature)
# Leave as placeholder to enable demo/mock Google OAuth flow
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
