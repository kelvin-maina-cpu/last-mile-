# =============================================================================
# REFLEX BACKEND — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string
# Production example: mongodb+srv://user:pass@cluster.mongodb.net/reflex?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/reflex

# Frontend origin allowed by CORS and auth redirects
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated list of allowed origins
# Production example: https://your-frontend.vercel.app,https://staging.yourdomain.com
CORS_ORIGINS=

# Google OAuth
# Create OAuth client in Google Cloud Console (Web application)
# Authorized redirect URI example: https://your-backend.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback URL (otherwise derived from request host)
GOOGLE_CALLBACK_URL=
# Optional secret used to sign OAuth state; defaults to GOOGLE_CLIENT_SECRET
OAUTH_STATE_SECRET=

# Logging (optional)
# Levels: fatal, error, warn, info, debug, trace
# Default: info in production, debug in development
LOG_LEVEL=
